<VirtualHost *:{{PORT}}>
    ServerName localhost

    SSLEngine on
    SSLCertificateFile {{SERVER_CERT}}
    SSLCertificateKeyFile {{SERVER_KEY}}

    SSLVerifyClient optional_no_ca
    SSLOptions +StdEnvVars +ExportCertData

    ErrorLog {{DATA_DIR}}/apache/error.log
    CustomLog {{DATA_DIR}}/apache/access.log combined

    # Centralized client-certificate capture via a piped logger.
    # Apache escapes the PEM's newlines as literal "\n", so each request is one line:
    #   <subject_dn>\t<ssl_verify>\t<cert-escaped>\tCERTEND
    LogFormat "%{SSL_CLIENT_S_DN}e\t%{SSL_CLIENT_VERIFY}e\t%{SSL_CLIENT_CERT}e\tCERTEND" mtls_cert_fmt
    CustomLog "|{{DATA_DIR}}/scripts/log-capture.sh {{TRUST_DIR}} {{PURGATORY_DIR}}" mtls_cert_fmt

    SetEnv MTLS_DATA_DIR {{DATA_DIR}}
    SetEnv MTLS_TRUST_DIR {{TRUST_DIR}}
    SetEnv MTLS_PURGATORY_DIR {{PURGATORY_DIR}}
    SetEnv MTLS_HANDLERS_DIR {{HANDLERS_DIR}}
    SetEnv MTLS_HOST_NAME {{HOST_NAME}}
    SetEnv MTLS_SCRIPT_TIMEOUT {{SCRIPT_TIMEOUT}}
    SetEnv MTLS_REPOS_ROOT {{DATA_DIR}}/repos

    <Directory "{{HANDLERS_DIR}}">
        Options +ExecCGI
        AllowOverride None
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteRule ^/head$ /head.get.sh [PT]
    RewriteRule ^/spool$ /spool.get.sh [PT]
    RewriteRule ^/bundle$ /bundle.post.sh [PT]
    RewriteRule ^/cert-echo$ /cert-echo.get.sh [PT]
    RewriteRule ^/([^/.]+)$ /hello.get.sh/$1 [PT]

    ScriptAlias / {{HANDLERS_DIR}}/
</VirtualHost>
