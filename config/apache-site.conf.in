<VirtualHost *:{{PORT}}>
    ServerName localhost

    SSLEngine on
    SSLCertificateFile {{SERVER_CERT}}
    SSLCertificateKeyFile {{SERVER_KEY}}

    SSLVerifyClient optional_no_ca
    SSLOptions +StdEnvVars +ExportCertData

    ErrorLog {{DATA_DIR}}/apache/error.log
    CustomLog {{DATA_DIR}}/apache/access.log combined

    # Centralized client-certificate capture via a piped logger.
    # Apache escapes the PEM's newlines as literal "\n", so each request is one line:
    #   <subject_dn>\t<ssl_verify>\t<cert-escaped>\tCERTEND
    LogFormat "%{SSL_CLIENT_S_DN}e\t%{SSL_CLIENT_VERIFY}e\t%{SSL_CLIENT_CERT}e\tCERTEND" mtls_cert_fmt
    CustomLog "|{{DATA_DIR}}/scripts/log-capture.sh {{TRUST_DIR}} {{PURGATORY_DIR}}" mtls_cert_fmt

    SetEnv MTLS_DATA_DIR {{DATA_DIR}}
    SetEnv MTLS_TRUST_DIR {{TRUST_DIR}}
    SetEnv MTLS_PURGATORY_DIR {{PURGATORY_DIR}}
    SetEnv MTLS_HANDLERS_DIR {{HANDLERS_DIR}}
    SetEnv MTLS_HOST_NAME {{HOST_NAME}}
    SetEnv MTLS_SCRIPT_TIMEOUT {{SCRIPT_TIMEOUT}}
    SetEnv MTLS_REPOS_ROOT {{DATA_DIR}}/repos
    SetEnv MTLS_DAV_PORT {{DAV_PORT}}
    SetEnv MTLS_NNCP_DIR   {{NNCP_DIR}}

    <Directory "{{HANDLERS_DIR}}">
        Options +ExecCGI
        AllowOverride None
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteRule ^/head$ /head.get.sh [PT]
    RewriteRule ^/spool$ /spool.get.sh [PT]
    RewriteRule ^/bundle$ /bundle.post.sh [PT]
    RewriteRule ^/cert-echo$ /cert-echo.get.sh [PT]
    RewriteRule ^/([^/.]+)$ /hello.get.sh/$1 [PT]

    # Per-host drop-box: all methods go through a single CGI proxy
    # handler that validates trust + CN-vs-URL-prefix, then forwards to
    # the loopback mod_dav VH. Must appear BEFORE the catch-all ScriptAlias.
    ScriptAlias /drop/ {{HANDLERS_DIR}}/drop-proxy.sh/

    # Per-host NNCP receive: POST /nncp/receive/ writes a NNCP-format
    # outer packet into <nncp_dir>/queues/<self-id>/inbound/ and hands
    # off to nncp-toss, which honours full-subscriber / relay-only /
    # unconfigured roles natively (/tmp/nncp-8.13.0/src/toss.go:802-973).
    ScriptAlias /nncp/receive/ {{HANDLERS_DIR}}/nncp-receive.post.sh/

    ScriptAlias / {{HANDLERS_DIR}}/
</VirtualHost>

# --- loopback mod_dav backend (feature 023) ---------------------------
# Bound to 127.0.0.1 only — reachable exclusively via the public VH's
# drop-proxy.sh CGI handler. Serves <data-dir>/drop/<cn>/<rest> via
# mod_dav_fs. No mTLS here; identity is enforced at the proxy edge.
<VirtualHost 127.0.0.1:{{DAV_PORT}}>
    # mod_dav's locking needs an on-disk lock-db. Without one the loopback VH
    # 500s on PUT/MOVE/COPY that try to acquire a write lock — concrete proof
    # in our own dav-error.log on first test run. Path is relative to
    # ServerRoot (= {{DATA_DIR}}/apache), so an absolute path here is fine.
    DAVLockDB "{{DATA_DIR}}/apache/dav-lockdb"

    DocumentRoot "{{DATA_DIR}}/drop"
    AllowEncodedSlashes NoDecode

    <Directory "{{DATA_DIR}}/drop">
        Options Indexes
        AllowOverride None
        Require all granted

        Dav On
        DavMinTimeout 120

    </Directory>

    ErrorLog {{DATA_DIR}}/apache/dav-error.log
    CustomLog {{DATA_DIR}}/apache/dav-access.log combined
</VirtualHost>
