{
	"name": "mtls-hello",
	"description": "Minimal mutual-TLS HTTP server: GET /:whatever returns $whatever as text/plain",
	"version": "0.1.4",
	"authors": [
		"mika"
	],
	"license": "MIT",
	"targetType": "executable",
	"preBuildCommands": [],
	"buildTypes": {
		"unittest": {
			"buildOptions": ["unittests"],
			"dflags": ["--linker=bfd"]
		}
	},
	"configurations": [
		{
			"name": "application",
			"targetType": "executable",
			"excludedSourceFiles": ["source/test_main.d"]
		},
		{
			"name": "unittest",
			"targetName": "mtls-hello-unittest",
			"targetType": "executable",
			"excludedSourceFiles": ["source/app.d"],
			"mainSourceFile": "source/test_main.d",
			"preBuildCommands": []
		}
	],
	"dependencies": {
		"vibe-core": "~>2.14",
		"vibe-stream:tls": "~>1.4"
	}
}
